    "text:fixed-nav:fixed-nav>header.nav>div.nav-inner>nav[aria-label=principal]>a[data-section=institucional]": "A Confidence",
    "text:clientes:div.screen-inner>div.clients-layout>div.client-board>article.client-card:nth-2>div.client-meta>span": "Superintendência dos Desportos do Estado da Bahia",
    "text:fixed-nav:fixed-nav>header.nav>div.nav-inner>button[data-section=contato]": "<i>Entre em contato conosco</i>",
    "text:contato:div.screen-inner>header.contact-head>div.eyebrow": "Tem algum projeto em mente?&nbsp;",
    "text:contato:div.screen-inner>header.contact-head>h2.title": "Entre em contato com a nossa equipe para tirar dúvidas e transformar a ideia do seu projeto em realidade.",
    "text:site-footer:site-footer>footer.site-footer>div.footer-main>div.footer-col:nth-2>div.footer-contact>div:nth-3": "<span>Endereço</span>&nbsp;Av. Juracy Magalhães, 3340, Felícia — Vitória da Conquista, BA&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;Edif. Empres. Multiplace Sala 303&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;CEP:&nbsp;45.055-235",
    "text:inicio:div.hero-inner>div>p.hero-lead": "Na Bahia, transformamos projetos em obras que ganham vida — da implantação ao acabamento, nós unimos experiência, precisão e atenção a cada detalhe.<br>",
    "text:inicio:div.hero-inner>aside.hero-aside>p": "Onde boas ideias encontram quem sabe construir.",
    "text:inicio:div.hero-inner>aside.hero-aside>strong": "<b>Construindo caminhos e marcando presença em cada canto da Bahia.</b>",
    "text:inicio:div.hero-inner>div>div.hero-identity-stage>div.hero-title-phase>h1": "Construímos hoje os espaços&nbsp; que <span>contarão histórias amanhã.</span>",
    "text:body:span": "Construímos história.",
    "text:inicio:div.hero-inner>div>div.hero-identity-stage>div.hero-title-phase>div.eyebrow.light": "Projetos · Engenharia · Construção · Infraestrutura · Transformação&nbsp;",
    "text:fixed-nav:fixed-nav>header.nav>div.nav-inner>button[data-section=contato]>i": "<b>Vamos construir juntos?</b><br>",
    "text:fixed-nav:fixed-nav>header.nav>div.nav-inner>button[data-section=contato]>i>b": "Vamos construir juntos?",
    "text:contato:div.screen-inner>header.contact-head>p.copy": "Escolha o canal que preferir.&nbsp;Através do formulário, sua mensagem será organizada e encaminhada ao WhatsApp para você revisar e enviar com praticidade.",
    "text:contato:div.screen-inner>article.contact-card>form.contact-form>div.contact-form-head>h3": "Vamos conversar sobre o seu projeto",
    "text:contato:div.screen-inner>article.contact-card>form.contact-form>div.contact-form-head>span": "Canal de contato com a Confidence Construtora para projetos, obras, parcerias e demais assuntos.",
    "text:contato:div.screen-inner>article.contact-card>form.contact-form>div.field-grid>div.field:nth-1>label": "Nome completo",
    "text:contato:div.screen-inner>article.contact-card>form.contact-form>div.field-grid>div.field:nth-2>label": "Empresa ou instituição",
    "text:contato:div.screen-inner>article.contact-card>form.contact-form>div.field-grid>div.field:nth-3>label": "Telefone ou WhatsApp<br>",
    "text:contato:div.screen-inner>article.contact-card>form.contact-form>div.field-grid>div.field:nth-4>label": "E-mail para contato",
    "text:contact-panel-title": "Estamos prontos para construir o próximo passo com você.\n",
    "text:contact-panel-eyebrow": "<u>Confidence Construtora</u>",
    "text:institucional:div.screen-inner>header.institutional-unified-head>div>div.eyebrow": "Quem somos",
    "text:institucional:div.screen-inner>header.institutional-unified-head>div>h2.title": "A confiança que sustenta cada projeto.",
    "text:institucional:div.screen-inner>header.institutional-unified-head>p.copy": "<span>Atuamos com responsabilidade social e ambiental, garantindo a sustentabilidade em todas as obras&nbsp;</span><span>e contribuindo positivamente para as comunidades onde estamos presentes.</span>",
    "text:certificacoes:div.screen-inner>div.certs-layout>div.section-brand-head>div.section-brand-head-copy>h2.title": "Qualidade que se constrói em cada etapa.<br>",
    "text:certificacoes:div.screen-inner>div.certs-layout>div.section-brand-head>div.section-brand-head-copy>p.copy": "Temos compromisso com a gestão de qualidade, a melhoria contínua e a excelência dos processos que sustentam cada empreendimento, controle e execução, fortalecendo a qualidade e a eficiência em cada projeto.",
    "text:institucional:div.screen-inner>div.institutional-stage>div.institutional-side>article.institutional-statement.primary>div.eyebrow": "Nossa missão",
    "text:institucional:div.screen-inner>div.institutional-stage>div.institutional-side>article.institutional-statement.primary>p": "<b>Projetamos, construímos e transformamos projetos em realidade.&nbsp;</b>",
    "text:institucional:div.screen-inner>div.institutional-stage>div.institutional-side>article.institutional-statement>h3": "Nós unimos conhecimento, excelência técnica, inovação e responsabilidade para entregar soluções cada vez mais eficientes.",
    "text:institucional:div.screen-inner>div.institutional-stage>div.institutional-side>article.institutional-statement.primary>h3": "Em nossos projetos, adotamos práticas conscientes que contribuem para o desenvolvimento sustentável das comunidades onde atuamos.",
    "text:obras:div.portfolio-region-inner>territory-map>div.territory-grid>div.territory-intro>div.eyebrow": "Obras que fazem parte da Bahia.",
    "text:obras:div.portfolio-region-inner>territory-map>div.territory-grid>div.territory-intro>h2.title": "Onde a nossa engenharia ganha forma.",
    "text:obras:div.portfolio-region-inner>territory-map>div.territory-grid>div.territory-intro>p.copy": "De Vitória da Conquista ao litoral, atuamos onde novos projetos ganham forma —&nbsp;&nbsp;acompanhamos o crescimento e a transformação de diferentes regiões, em diferentes municípios, obras e frentes de execução.",
    "text:obras:div.portfolio-region-inner>territory-map>div.territory-grid>div.territory-intro>div.city-columns>div[data-city=ubaitaba]>span.city-button-copy>a[data-work-link=centro-canoagem-ubaitaba]": "Reestruturação do Centro de Canoagem",
    "text:obras:div.portfolio-region-inner>territory-map>div.territory-grid>div.territory-intro>div.city-columns>div[data-city=barra-do-choca]>span.city-button-copy>a[data-work-link=areninha-barra-do-choca]": "Construção de Arena Esportiva",
    "text:obras:div.portfolio-region-inner>territory-map>div.territory-grid>div.map-stage>div.map-current>a[data-work-link=areninha-barra-do-choca]": "Construção de Arena Esportiva",
    "text:obras:div.portfolio-region-inner>territory-map>div.territory-grid>div.territory-intro>div.city-columns>div[data-city=seabra]>span.city-button-copy>a[data-work-link=estadio-seabra]": "Construção do Estádio Municipal",
    "text:obras:div.portfolio-region-inner>territory-map>div.territory-grid>div.map-stage>div.map-current>a[data-work-link=estadio-seabra]": "Construção do Estádio Municipal",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section.detail-workspace>aside[aria-label=informacoes-da-obra]>div[aria-label=identificacao-da-obra]>div.detail-data-row:nth-1>span": "Local",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section.detail-workspace>aside[aria-label=informacoes-da-obra]>p.detail-summary": "Cercamento metálico e alambrado da quadra.&nbsp; &nbsp; Passeios em piso intertravado.&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Infraestrutura elétrica externa.&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Movimentação e regularização do terreno.",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section.detail-workspace>aside[aria-label=informacoes-da-obra]>div[aria-label=identificacao-da-obra]>div.detail-data-row:nth-2>strong": " Construção de arena esportiva",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section.detail-workspace>aside[aria-label=informacoes-da-obra]>h1": "Construção de Arena Esportiva",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section.detail-endcap>div.detail-endcap-inner>h2": "Cada registro corresponde a uma etapa da execução da obra.<span></span>\n",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section.detail-endcap>div.detail-endcap-inner>p": "<strong>Execução de serviços de escavação, movimentação, nivelamento e regularização do terreno para implantação da arena esportiva.</strong>",
    "text:institucional:div.screen-inner>header.institutional-unified-head>p.copy>span:nth-1": "Construir com propósito, entregar com excelência e transformar com responsabilidade.<br>",
    "text:institucional:div.screen-inner>header.institutional-unified-head>p.copy>span:nth-2": "Nosso compromisso vai além da execução de cada obra.",
    "text:institucional:div.screen-inner>div.institutional-stage>div.institutional-side>article.institutional-statement>div.eyebrow": "Nosso caminho",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section#execucao>div.detail-execution-inner>header.detail-execution-head>div.detail-execution-intro>p": "A seguir, estão apresentados os registros das atividades e dos serviços efetuados na obra, com a respectiva descrição técnica e o detalhamento de cada etapa executada.",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section#execucao>div.detail-execution-inner>header.detail-execution-head>div.detail-execution-intro>div.detail-execution-meta>span:nth-3": "24 registros de atividade",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section#execucao>div.detail-execution-inner>header.detail-execution-head>div>h2#execution-title": "Acompanhe a evolução da obra.",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section#execucao>div.detail-execution-inner>div.service-journey-list>article.service-journey-item:nth-1>div.service-journey-copy>p": "Execução dos serviços de escavação mecanizada e movimentação do solo na área externa da areninha, com preparação, nivelamento e regularização do terreno para o seguimento da obra.&nbsp;",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section#execucao>div.detail-execution-inner>div.service-journey-list>article.service-journey-item:nth-1>div.service-journey-copy>h3": "Preparação, terraplenagem e escavação.",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section#execucao>div.detail-execution-inner>div.service-journey-list>article.service-journey-item:nth-1>figure.service-journey-visual>figcaption.service-journey-caption>span:nth-2": "Preparação e escavação",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section#execucao>div.detail-execution-inner>div.service-journey-list>article.service-journey-item:nth-2>div.service-journey-copy>h3": "Montagem e instalação do alambrado.",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section#execucao>div.detail-execution-inner>div.service-journey-list>article.service-journey-item:nth-2>figure.service-journey-visual>figcaption.service-journey-caption>span:nth-2": "Cercamento",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section#execucao>div.detail-execution-inner>div.service-journey-list>article.service-journey-item:nth-2>div.service-journey-copy>p": "Execução do fechamento perimetral da quadra, com instalação de postes, alambrado e elementos de fixação, visando a delimitação e proteção da área esportiva.<br><br>",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section#execucao>div.detail-execution-inner>div.service-journey-list>article.service-journey-item:nth-3>div.service-journey-copy>p": "Execução e montagem da estrutura metálica da areninha, incluindo a instalação dos elementos estruturais da cobertura.&nbsp;",
    "text:obra-areninha-barra-do-choca:work-detail>main.detail-route>section#execucao>div.detail-execution-inner>div.service-journey-list>article.service-journey-item:nth-3>div.service-journey-copy>h3": "Instalação do alambrado e fechamento perimetral.",
